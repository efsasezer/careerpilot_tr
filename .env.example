# Bu dosyayı .env olarak kopyalayın. Yerel başlatma scriptleri okur; .env Git'e eklenmez.

# Giriş şifresi (zorunlu). Tarayıcıda saklanmaz; sunucuda sabit zamanlı karşılaştırılır.
CAREERPILOT_PASSWORD=
# Oturum çerezini imzalayan gizli anahtar (zorunlu, en az 16 karakter).
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
CAREERPILOT_SESSION_SECRET=

# Veritabanı yolu. Varsayılan: proje kökündeki careerpilot.db.
# Render'da kalıcı disk kullanıyorsanız: DATABASE_URL=sqlite:////var/data/careerpilot.db
# ve ilk açılışta depodaki ilan verisiyle başlatmak için CAREERPILOT_DB_SEED_FROM_REPO=true
# DATABASE_URL=

# Taranmış PDF'ler için OCR: on | off. Varsayılan: yerelde açık, Render'da kapalı (bellek sınırı).
# CAREERPILOT_OCR=on

# Sunucu içi otomatik tarama aralığı (saat). Varsayılan 0: kapalı.
# Yerel çalıştırmada kaynakları 12 saatte bir yenile.
CAREERPILOT_SYNC_INTERVAL_HOURS=12

# İsteğe bağlı dış bildirim kanalları (uygulama içi bildirimler bunlar olmadan çalışır)
# CAREERPILOT_SMTP_HOST=
# CAREERPILOT_SMTP_PORT=587
# CAREERPILOT_SMTP_USER=
# CAREERPILOT_SMTP_PASSWORD=
# CAREERPILOT_SMTP_FROM=
# CAREERPILOT_TELEGRAM_BOT_TOKEN=
# CAREERPILOT_NOTIFY_EMAIL_TO=
# CAREERPILOT_NOTIFY_TELEGRAM_CHAT_ID=
