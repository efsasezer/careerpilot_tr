# Bu dosyayı .env olarak kopyalayın. scripts/run_api.sh bu dosyayı okur; .env Git'e eklenmez.

# API erişim anahtarı (zorunlu). Boş bırakırsanız run_api.sh ilk çalıştırmada rastgele üretir.
CAREERPILOT_ACCESS_TOKEN=

# Otomatik kaynak taraması aralığı (saat). 0 = kapalı. Varsayılan 6.
CAREERPILOT_SYNC_INTERVAL_HOURS=6

# Bildirim e-postalarındaki bağlantı için arayüz adresi.
CAREERPILOT_APP_URL=http://localhost:5173

# E-posta bildirimi (isteğe bağlı)
CAREERPILOT_SMTP_HOST=
CAREERPILOT_SMTP_PORT=587
CAREERPILOT_SMTP_USER=
CAREERPILOT_SMTP_PASSWORD=
CAREERPILOT_SMTP_FROM=

# Telegram bildirimi (isteğe bağlı): @BotFather ile oluşturduğunuz botun anahtarı
CAREERPILOT_TELEGRAM_BOT_TOKEN=

# Salt okunur yayın (veri değiştiren istekler ve tarama kapanır)
# CAREERPILOT_DEMO_MODE=true

# careerpilot.db yoksa boş veritabanı oluşturulsun
# CAREERPILOT_DB_AUTOCREATE=true
